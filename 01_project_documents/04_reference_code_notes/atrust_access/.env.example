# macOS单文件sh（内嵌Python）的空配置模板，不含真实凭据；Windows/Linux手动流程不使用本模板自动登录。
# 先在自己的目录新建.env并限制权限600，绝不分发填好的.env。
# 本文件被shell source；只使用自己编写的可信配置。不要把命令替换/脚本放入变量值。

# 必填：自己已经安装的Conda环境Python绝对路径。
# 在激活目标环境后，用 python -c 'import sys; print(sys.executable)' 查询；不要照抄作者机器路径。
ECNU_VPN_PYTHON='/ABSOLUTE/PATH/TO/YOUR/CONDA/ENV/bin/python'

# 学校官方VPN入口；当前代码只允许已核验的ECNU域名，不用于切换到第三方入口。
ECNU_VPN_HOST='vpn.ecnu.edu.cn'

# 可选：分流范围，默认hpc只纳入三个超算地址；ecnu/custom需另行核实学校授权。
ECNU_VPN_SCOPE='hpc'
# 仅custom需要：由学校/资源管理员给出的严格公网IPv4 CIDR，空格分隔。
# ECNU_IPRANGE='59.78.189.132/32'

# 可选：自动浏览器模式isolated默认；bridge需Chrome扩展授权，未作为稳定一键方式验收。
ECNU_ATRUST_BROWSER='isolated'

# 可选：本人学校统一认证学号/密码，来源为学校身份系统。
# 仅未登录时自动SSO必需；先在官方客户端手动登录再start则可保留为空。
# 特殊字符需正确shell转义，并确认与Playwright MCP秘密文件解析兼容。
ECNU_USERNAME=''
ECNU_PASSWORD=''

# 超算资源地址：向管理员核实，默认沿用当前历史三个地址；不代表自动取得资源权限。
# 当前脚本要求IPv4地址，不填域名。
HPC_LOGIN_HOST='59.78.189.132'
HPC_BACKUP_HOST='59.78.189.133'
HPC_MANUAL_HOST='59.78.189.195'

# SSH端口：由超算管理员提供，目前历史配置2323。
HPC_LOGIN_PORT='2323'
# 本人超算账号/密码：由超算管理员开通，不能用作者或同学的账号。
# 仅脚本ssh-test/ssh-hpc/connect必需；用系统ssh交互输入则可不保存密码。
# 使用脚本SSH前必须填写本人账号，不能保留为空或依赖源码默认账号。
HPC_SSH_USER=''
HPC_SSH_PASSWORD=''
# 可选：SSH认证等待秒数，默认45，不自动重试。
HPC_SSH_TIMEOUT='45'

# 可选：审计状态根目录，默认当前用户~/.ecnu-vpn，含私有网络信息，不分享。
# ECNU_VPN_STATE_DIR='/ABSOLUTE/PATH/TO/YOUR/PRIVATE/STATE'

# 推荐不设置LOCAL_SUDO_PASSWORD；在终端按提示输入本机管理员密码。
# 这不是校园/超算密码，不把本机sudo密码发给任何人。
# 不在此处设置ECNU_SERVER_ENV_FILE；每次在终端显式export自己的.env绝对路径。
