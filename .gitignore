*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# 本地环境变量与凭据（只提交脱敏示例）
.env
.env.*
!.env.example
!.env.*.example

# Jupyter 与临时输出
.ipynb_checkpoints/
tmp/
temp/
cache/
outputs/tmp/

