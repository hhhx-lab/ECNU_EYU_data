#!/bin/bash
# =============================================================================
# SLURM 作业脚本: 数据预处理 (纯 CPU)
# 适用集群: 华东师范大学超算八期
# =============================================================================
# 使用方式:
#   sbatch slurm/preprocess.slurm
# =============================================================================

# ---------------------------------------------------------------------------
# SLURM 资源申请
# ---------------------------------------------------------------------------
#SBATCH -J brats_preprocess
#SBATCH -p cpu_96G
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH -t 01:00:00
#SBATCH -o logs/slurm/%x-%j.out
#SBATCH -e logs/slurm/%x-%j.err

# ---------------------------------------------------------------------------
# 用户可配置变量
# ---------------------------------------------------------------------------
WORK_DIR="${WORK_DIR:-/public/home/zqchen/SegMamba-main}"
CONDA_ENV="${CONDA_ENV:-segmamba}"


cd "$WORK_DIR" || { echo "ERROR: 工作目录不存在: $WORK_DIR"; exit 1; }

# ---------------------------------------------------------------------------
# 环境初始化
# ---------------------------------------------------------------------------
echo "=============================================="
echo "SLURM Job ID:    ${SLURM_JOB_ID}"
echo "Job Name:        ${SLURM_JOB_NAME}"
echo "Partition:       ${SLURM_JOB_PARTITION}"
echo "Start Time:      $(date)"
echo "=============================================="
echo ""

# 使用 conda 环境的绝对路径 Python (最稳妥, 避开 PATH 和 Shell 初始化问题)
ENV_PYTHON="/public/home/zqchen/.conda/envs/${CONDA_ENV}/bin/python"

echo "Python: $($ENV_PYTHON --version)"
echo ""

# ---------------------------------------------------------------------------
# 运行预处理
# ---------------------------------------------------------------------------
echo "[1/2] 重命名数据..."
$ENV_PYTHON 1_rename_mri_data.py
echo ""

echo "[2/2] 预处理 MRI..."
$ENV_PYTHON 2_preprocessing_mri.py
echo ""

# ---------------------------------------------------------------------------
# 检查结果
# ---------------------------------------------------------------------------
echo "=============================================="
echo "预处理完成 — $(date)"
echo "=============================================="

DATA_COUNT=$(ls data/fullres/train/*.npz 2>/dev/null | wc -l)
echo "生成 npz 文件: $DATA_COUNT 个"

if [[ $DATA_COUNT -eq 0 ]]; then
    echo "ERROR: 未生成预处理文件，请检查日志"
    exit 1
fi

echo "预处理成功!"
