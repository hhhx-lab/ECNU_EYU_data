# 新 H20 云主机上的项目根目录。不得写入密码、Token 或 SSH 私钥。
PROJECT_ROOT=/root/brats2026/ECNU_EYU_data

# Dataset264 专用数据根。raw 和 preprocessed 必须来自 ECNU 已验收缓存。
S2_DATA_ROOT=/root/brats2026/data/s2_dataset264
NNUNET_RAW_ROOT=/root/brats2026/data/s2_dataset264/nnUNet_raw
NNUNET_PREPROCESSED_ROOT=/root/brats2026/data/s2_dataset264/nnUNet_preprocessed

# Route A 新运行根。必须是从未用于其他 Route 或参数的独立目录。
ROUTE_ROOT=/root/brats2026/runs/s2_met_aug_route_a_20260725

# 从基础 py312 镜像克隆的独立 Conda 环境；不得污染 py312。
BASE_ENV_PATH=/usr/local/miniconda3/envs/py312
CONDA_ENV_PATH=/root/brats2026/envs/s2_met_aug_h20
CONDA_BIN=/usr/local/miniconda3/bin/conda

# nnU-Net 2.8 排除 torch 2.9.*；固定使用已在 H20 和本地测试验证的 cu128 组合。
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
S2_TORCH_VERSION=2.7.1
S2_TORCHVISION_VERSION=0.22.1
S2_TORCHAUDIO_VERSION=2.7.1
S2_TORCH_CUDA=12.8

# 两条配对训练分别绑定一张卡。单个任务只允许看到一张 GPU。
CONTROL_GPU=0
ROUTE_A_GPU=1

# 1TB 根盘至少保留的安全空间。低于该值时 Gate 或训练拒绝启动。
MIN_FREE_GIB=150

# training smoke 对 Route A 200 epoch 的最大可接受估时，超过后不自动启动正式训练。
SMOKE_MAX_ESTIMATED_HOURS=45

# 两组并行时各自使用的 CPU 线程数，避免 44 核主机过度竞争。
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
