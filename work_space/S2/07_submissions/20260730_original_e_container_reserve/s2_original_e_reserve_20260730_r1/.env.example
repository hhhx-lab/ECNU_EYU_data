# 本地镜像标签；非密钥，可按需改成你的本地名称。
IMAGE=s2-original-e-reserve:experimental_unvalidated

# 基础镜像；必须保持 PyTorch 2.7.1 和 CUDA 12.8 的已验证主版本。
BASE_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

# 构建前静态验证使用的项目 Python；默认从当前 Conda 环境解析。
PYTHON_BIN=python

# 原 E checkpoint 所在目录；目录内必须有 checkpoint_final.pth。
CHECKPOINT_DIR=../../results/s2_small_lesion_ablation_20260721/remote_snapshot_complete_20260724T0343/focal/fold_0

# 本地 GPU 离线测试时的输入根目录；必须是绝对路径。
INPUT_DIR=/absolute/path/to/Validation

# 本地 GPU 离线测试时的空输出目录；必须是绝对路径。
OUTPUT_DIR=/absolute/path/to/empty-output

# nnU-Net 预处理和导出 worker 数；A10G/16 vCPU 先使用已验证的 4/4。
S2_PREPROCESS_WORKERS=4
S2_EXPORT_WORKERS=4
