# 项目代码根目录。必须是本仓库在服务器上的绝对路径。
PROJ=/root/brats2026/ECNU_EYU_data

# G1 Diffusion V3 的运行目录，保存软链接数据视图、CSV、日志和 checkpoint。
RUN_ROOT=/root/brats2026/runs/g1_diffusion_v3

# 训练原始数据根目录。支持病例直接位于此目录，或位于其 UCSD - Training 子目录。
RAW_ROOT=/root/brats2026/raw_source/MICCAI-LH-BraTS2025-MET-Challenge-Training

# 两个官方修正标签所在目录；正式准备数据时必须存在。
CORRECTED_LABEL_ROOT=/root/brats2026/corrected_labels

# 独立 Conda 环境路径。不得使用 sudo pip 或污染基础 py312 环境。
CONDA_ENV_PATH=/root/brats2026/envs/g1_diffusion_v3

# G2 固定来源清单；只允许 823 train 和 103 val 的 authentic T2W 病例。
SOURCE_MANIFEST=/root/brats2026/ECNU_EYU_data/work_space/G2/results/manifests/g1_v2_source_manifest.csv

# 优化器训练总步数。150000 表示十五万次 optimizer step，不是扩散时间步。
NUM_STEPS=150000

# 扩散时间步，必须保持 1000；不要与 NUM_STEPS 混淆。
N_STEPS=1000

# 每多少 optimizer step 原子保存一次可续训 checkpoint。
CHECKPOINT_INTERVAL=5000

# 每个模态最多保留多少个最新 checkpoint，防止 76GB 系统盘被写满。
KEEP_LAST_CHECKPOINTS=6

# 单卡 batch；正式预检若 OOM，统一改为 4 后重新预检。
BATCH_SIZE=8

# 是否启用 torch.compile。1 为启用；预检失败时改为 0。
USE_COMPILE=1

# MONAI DataLoader worker 数。全量 NIfTI 会在读取时解压；0 会让 GPU 等待 I/O。
# 四卡云端正式配置使用 16；若单机内存不足，依次降为 8、4，并重新测速。
LOADER_WORKERS=16

# 多 worker 会跨进程传 tensor；提高软文件描述符上限，避免 received 0 items of ancdata。
OPEN_FILES_LIMIT=65536

# 普通云主机单模态训练的最长运行秒数。144000=40 小时；到时先发
# SIGTERM，让训练完成当前 optimizer step 并原子保存 checkpoint。0 表示不设截止。
TRAIN_MAX_RUNTIME_SECONDS=144000

# 收到停止信号后最多等待多少秒完成当前 step 和 checkpoint；超时只报警，不强杀。
TRAIN_STOP_GRACE_SECONDS=1800
