        {
          "line": 3,
          "text": "\u652f\u6301\u591a\u79cd\u635f\u5931\u51fd\u6570\u53ca\u5176\u7ec4\u5408\uff0c\u9488\u5bf9 BraTS 2026 \u533b\u5b66\u5206\u5272\u4efb\u52a1\u4f18\u5316\u3002"
        },
        {
          "line": 17,
          "text": "class DiceLoss(nn.Module):"
        },
        {
          "line": 19,
          "text": "    Soft Dice Loss"
        },
        {
          "line": 34,
          "text": "            loss: scalar"
        },
        {
          "line": 36,
          "text": "        num_classes = pred.shape[1]"
        },
        {
          "line": 38,
          "text": "        target = target.clamp(0, num_classes - 1)"
        },
        {
          "line": 44,
          "text": "        target_onehot = F.one_hot(target.long(), num_classes).permute(0, -1, *range(1, target.dim())).float()"
        },
        {
          "line": 47,
          "text": "        pred_flat = pred_soft.view(pred.shape[0], num_classes, -1)"
        },
        {
          "line": 48,
          "text": "        target_flat = target_onehot.view(target_onehot.shape[0], num_classes, -1)"
        },
        {
          "line": 54,
          "text": "        dice_loss = 1.0 - dice"
        },
        {
          "line": 57,
          "text": "            return dice_loss.mean()"
        },
        {
          "line": 59,
          "text": "            return dice_loss.sum()"
        },
        {
          "line": 60,
          "text": "        return dice_loss"
        },
        {
          "line": 63,
          "text": "class FocalLoss(nn.Module):"
        },
        {
          "line": 65,
          "text": "    Focal Loss"
        },
        {
          "line": 70,
          "text": "    def __init__(self, alpha=1.0, gamma=2.0, reduction='mean', num_classes=5):"
        },
        {
          "line": 75,
          "text": "        self.num_classes = num_classes"
        },
        {
          "line": 83,
          "text": "            loss: scalar"
        },
        {
          "line": 85,
          "text": "        target = target.clamp(0, self.num_classes - 1)"
        },
        {
          "line": 86,
          "text": "        ce_loss = F.cross_entropy(pred, target, reduction='none')"
        },
        {
          "line": 87,
          "text": "        pt = torch.exp(-ce_loss)"
        },
        {
          "line": 88,
          "text": "        focal_loss = self.alpha * (1 - pt) ** self.gamma * ce_loss"
        },
        {
          "line": 91,
          "text": "            return focal_loss.mean()"
        },
        {
          "line": 93,
          "text": "            return focal_loss.sum()"
        },
        {
          "line": 94,
          "text": "        return focal_loss"
        },
        {
          "line": 97,
          "text": "class WeightedCrossEntropyLoss(nn.Module):"
        },
        {
          "line": 99,
          "text": "    \u5e26\u6743\u91cd\u7684 Cross Entropy Loss"
        },
        {
          "line": 102,
          "text": "    def __init__(self, weight=None, reduction='mean', num_classes=5):"
        },
        {
          "line": 109,
          "text": "        self.num_classes = num_classes"
        },
        {
          "line": 112,
          "text": "        target = target.clamp(0, self.num_classes - 1)"
        },
        {
          "line": 116,
          "text": "class CombinedLoss(nn.Module):"
        },
        {
          "line": 124,
          "text": "        focal_alpha: Focal loss alpha \u53c2\u6570"
        },
        {
          "line": 125,
          "text": "        focal_gamma: Focal loss gamma \u53c2\u6570"
        },
        {
