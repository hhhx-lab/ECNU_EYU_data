        {
          "line": 138,
          "text": "        num_classes=5,"
        },
        {
          "line": 145,
          "text": "        self.num_classes = num_classes"
        },
        {
          "line": 153,
          "text": "        # CE Loss \u2014 \u6743\u91cd\u5728 __init__ \u65f6\u521b\u5efa\u597d (\u907f\u514d\u6bcf\u4e2a forward \u65b0\u5efa tensor)"
        },
        {
          "line": 155,
          "text": "            assert len(weights) == num_classes, \\"
        },
        {
          "line": 156,
          "text": "                f\"ce_class_weights \u957f\u5ea6 ({len(weights)}) != num_classes ({num_classes})\""
        },
        {
          "line": 157,
          "text": "            self.ce_fn = WeightedCrossEntropyLoss("
        },
        {
          "line": 158,
          "text": "                weight=weights, reduction='mean', num_classes=num_classes"
        },
        {
          "line": 161,
          "text": "            self.ce_fn = WeightedCrossEntropyLoss("
        },
        {
          "line": 162,
          "text": "                weight=None, reduction='mean', num_classes=num_classes"
        },
        {
          "line": 165,
          "text": "        self.dice_fn = DiceLoss()"
        },
        {
          "line": 166,
          "text": "        self.focal_fn = FocalLoss(alpha=focal_alpha, gamma=focal_gamma, num_classes=num_classes)"
        },
        {
          "line": 174,
          "text": "            total_loss: scalar"
        },
        {
          "line": 175,
          "text": "            loss_dict: dict with individual loss values"
        },
        {
          "line": 178,
          "text": "        target = target.clamp(0, self.num_classes - 1)"
        },
        {
          "line": 180,
          "text": "        total_loss = 0.0"
        },
        {
          "line": 181,
          "text": "        loss_dict = {}"
        },
        {
          "line": 184,
          "text": "            ce_loss = self.ce_fn(pred, target)"
        },
        {
          "line": 185,
          "text": "            total_loss += self.ce_weight * ce_loss"
        },
        {
          "line": 186,
          "text": "            loss_dict['ce'] = ce_loss.item()"
        },
        {
          "line": 189,
          "text": "            dice_loss = self.dice_fn(pred, target)"
        },
        {
          "line": 190,
          "text": "            total_loss += self.dice_weight * dice_loss"
        },
        {
          "line": 191,
          "text": "            loss_dict['dice'] = dice_loss.item()"
        },
        {
          "line": 194,
          "text": "            focal_loss = self.focal_fn(pred, target)"
        },
        {
          "line": 195,
          "text": "            total_loss += self.focal_weight * focal_loss"
        },
        {
          "line": 196,
          "text": "            loss_dict['focal'] = focal_loss.item()"
        },
        {
          "line": 198,
          "text": "        loss_dict['total'] = total_loss.item()"
        },
        {
          "line": 199,
          "text": "        return total_loss, loss_dict"
        },
        {
          "line": 202,
          "text": "def get_loss_function(config):"
